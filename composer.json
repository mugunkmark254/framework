{
  "name": "mugunkmark254/framework",
  "description": "A small PHP web framework built from scratch for learning and experimentation.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "Taydence\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Taydence\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "test": "phpunit",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  }
}
